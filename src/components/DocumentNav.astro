---
import { localePath } from "../lib/locales";
import { publicPath } from "../lib/site";
import { legalDocumentsBySlug, type LegalKind } from "../data/legal";
import type { Locale } from "../lib/types";
import { ui } from "../lib/ui";

interface Props {
  locale: Locale;
  slug: string;
  current?: LegalKind;
}

const { locale, slug, current } = Astro.props;
const labels: Record<LegalKind, string> = {
  privacy: ui[locale].privacy,
  support: ui[locale].support,
  terms: ui[locale].terms,
  marketing: ui[locale].marketing
};
const availableKinds = (Object.keys(labels) as LegalKind[]).filter((kind) => legalDocumentsBySlug[slug]?.[locale]?.[kind]);
---

<nav class="document-nav" aria-label={ui[locale].documents}>
  {availableKinds.map((kind) => (
    <a href={publicPath(localePath(locale, `apps/${slug}/${kind}`))} aria-current={current === kind ? "page" : undefined}>
      {labels[kind]}
    </a>
  ))}
</nav>
