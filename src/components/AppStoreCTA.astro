---
import { localeDefaultStorefront } from "../lib/locales";
import { storefrontDataAttributes } from "../lib/storefront-dom";
import { getListingDisplayName, resolveListing } from "../lib/storefront";
import type { AppRecord, Locale } from "../lib/types";
import { storefrontLabels, ui } from "../lib/ui";

interface Props {
  app: AppRecord;
  locale: Locale;
  compact?: boolean;
}

const { app, locale, compact = false } = Astro.props;
const requestedStorefront = localeDefaultStorefront[locale];
const resolved = resolveListing(app, requestedStorefront);
const initialMessage = resolved.listing.state === "planned"
  ? resolved.listing.url
    ? ui[locale].releasePlanned(storefrontLabels[locale][resolved.resolvedStorefront])
    : ui[locale].releasePreparing
  : ui[locale].availableIn(storefrontLabels[locale][resolved.resolvedStorefront]);
const attributes = storefrontDataAttributes(app, locale);
---

<div class:list={["app-store-cta", { "app-store-cta--compact": compact }]}>
  {resolved.listing.url && <a
      {...attributes}
      data-storefront-cta
      href={resolved.listing.url}
      target="_blank"
      rel="noreferrer"
      aria-label={`${ui[locale].openAppStore}: ${getListingDisplayName(resolved.listing)}`}
    >
      <span>{ui[locale].openAppStore}</span>
      <span aria-hidden="true">↗</span>
    </a>}
  {!resolved.listing.url && <span {...attributes} data-storefront-status>{ui[locale].releasePreparing}</span>}
  <p {...attributes} data-storefront-note data-state={resolved.listing.state}>{initialMessage}</p>
</div>
