---
import AppCard from "../../components/AppCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { apps } from "../../data/apps";
import { locales } from "../../lib/locales";
import { appSupportsLocale } from "../../lib/apps";
import { publicPath } from "../../lib/site";
import type { Locale } from "../../lib/types";
import { ui } from "../../lib/ui";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const labels = ui[locale];
const visibleApps = apps.filter((app) => app.slug === "fuzhixing-dashcam" && appSupportsLocale(app, locale));
---

<SiteLayout locale={locale} title="测试小站" description={labels.galleryBody}>
  <section class="studio-hero page-shell">
    <div class="studio-hero__copy">
      <p class="section-label">{labels.galleryEyebrow}</p>
      <h1>Small apps.<br /><em>Clearer days.</em></h1>
      <p class="studio-hero__body">福之行车记录仪正在上架中，敬请期待。</p>
      <div class="studio-hero__actions">
        <a class="button-link" href="#apps">查看应用<span aria-hidden="true"> ↓</span></a>
      </div>
    </div>
    <div class="studio-hero__art" aria-hidden="true">
      <div class="studio-hero__orb studio-hero__orb--one"></div>
      <div class="studio-hero__orb studio-hero__orb--two"></div>
      <img src={publicPath("/assets/apps/fuzhixing-dashcam/web/screen-01.webp")} alt="" />
      <img src={publicPath("/assets/apps/fuzhixing-dashcam/web/icon.webp")} alt="" />
    </div>
  </section>

  <section class="app-gallery page-shell" id="apps" aria-labelledby="apps-heading">
    <header class="section-heading">
      <p class="section-label">{labels.galleryEyebrow}</p>
      <h2 id="apps-heading">福之行车记录仪 · 上架中</h2>
    </header>
    <div class="app-gallery__grid">
      {visibleApps.map((app, index) => <AppCard app={app} locale={locale} position={index + 1} />)}
    </div>
  </section>
</SiteLayout>
