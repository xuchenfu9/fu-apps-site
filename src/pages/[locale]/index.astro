---
import AppCard from "../../components/AppCard.astro";
import FeaturedApp from "../../components/FeaturedApp.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { apps } from "../../data/apps";
import { locales } from "../../lib/locales";
import { appSupportsLocale } from "../../lib/apps";
import { publicPath } from "../../lib/site";
import type { Locale } from "../../lib/types";
import { ui } from "../../lib/ui";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const labels = ui[locale];
const visibleApps = apps.filter((app) => appSupportsLocale(app, locale));
const featuredSlugs = ["banzhuren", "perfectlist", "jiajia-id-photo"];
const featuredImageBySlug: Partial<Record<string, string>> = {
  banzhuren: "/assets/apps/banzhuren/web/recommendation-download.jpg"
};
const featuredApps = featuredSlugs
  .map((slug) => apps.find((app) => app.slug === slug))
  .filter((app): app is (typeof apps)[number] => Boolean(app && appSupportsLocale(app, locale)));
---

<SiteLayout locale={locale} title="测试小站" description={labels.galleryBody}>
  <section class="studio-hero page-shell">
    <div class="studio-hero__copy">
      <p class="section-label">{labels.galleryEyebrow}</p>
      <h1>Small apps.<br /><em>Clearer days.</em></h1>
      <p class="studio-hero__body">班主任小秘书已上架，现作为本站重点推荐；同时为你整理了更多实用 App。</p>
      <div class="studio-hero__actions">
        <a class="button-link" href="#featured">重点推荐<span aria-hidden="true"> ↓</span></a>
        <a class="text-link" href="#apps">全部 App<span aria-hidden="true"> ↘</span></a>
      </div>
    </div>
    <div class="studio-hero__art" aria-hidden="true">
      <div class="studio-hero__orb studio-hero__orb--one"></div>
      <div class="studio-hero__orb studio-hero__orb--two"></div>
      <img src={publicPath("/assets/apps/banzhuren/web/screen-01.webp")} alt="" />
      <img src={publicPath("/assets/apps/banzhuren/web/icon.webp")} alt="" />
    </div>
  </section>

  <section class="featured-section page-shell" id="featured" aria-labelledby="featured-heading">
    <header class="section-heading section-heading--intro">
      <div><p class="section-label">{labels.galleryEyebrow}</p><h2 id="featured-heading">重点推荐</h2></div>
      <p>从班务管理到时间安排和证件照制作，先看看我们最值得推荐的三款 App。</p>
    </header>
    <div class="featured-grid">
      {featuredApps.map((app, index) => <FeaturedApp app={app} locale={locale} tone={index === 0 ? "coral" : index === 1 ? "blue" : "green"} image={featuredImageBySlug[app.slug]} />)}
    </div>
  </section>

  <section class="app-gallery page-shell" id="apps" aria-labelledby="apps-heading">
    <header class="section-heading">
      <p class="section-label">{labels.galleryEyebrow}</p>
      <h2 id="apps-heading">全部 App</h2>
    </header>
    <div class="app-gallery__grid">
      {visibleApps.map((app, index) => <AppCard app={app} locale={locale} position={index + 1} />)}
    </div>
  </section>
</SiteLayout>
