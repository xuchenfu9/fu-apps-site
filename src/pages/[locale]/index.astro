---
import AppCard from "../../components/AppCard.astro";
import FeaturedApp from "../../components/FeaturedApp.astro";
import UpdateRow from "../../components/UpdateRow.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { apps } from "../../data/apps";
import { locales } from "../../lib/locales";
import { appSupportsLocale } from "../../lib/apps";
import { publicPath } from "../../lib/site";
import type { Locale } from "../../lib/types";
import { ui } from "../../lib/ui";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const labels = ui[locale];
const visibleApps = apps.filter((app) => appSupportsLocale(app, locale));
const featuredSlugs = ["banzhuren", "perfectlist", "meowtalk-diary"];
const featuredApps = featuredSlugs.map((slug) => apps.find((app) => app.slug === slug)).filter((app): app is (typeof apps)[number] => Boolean(app && appSupportsLocale(app, locale)));
const updateApps = visibleApps.filter((app) => app.release).slice(0, 5);
---

<SiteLayout locale={locale} title="FU apps" description={labels.galleryBody}>
  <section class="studio-hero page-shell">
    <div class="studio-hero__copy">
      <p class="section-label">{labels.galleryEyebrow}</p>
      <h1>Small apps.<br /><em>Clearer days.</em></h1>
      <p class="studio-hero__body">{labels.studioIntro}</p>
      <div class="studio-hero__actions">
        <a class="button-link" href="#featured">{labels.featuredApps}<span aria-hidden="true"> ↓</span></a>
        <a class="text-link" href="#apps">{labels.exploreApps}<span aria-hidden="true"> ↘</span></a>
      </div>
    </div>
    <div class="studio-hero__art" aria-hidden="true">
      <div class="studio-hero__orb studio-hero__orb--one"></div>
      <div class="studio-hero__orb studio-hero__orb--two"></div>
      <img src={publicPath("/assets/apps/appstoryline/web/screen-01.webp")} alt="" />
      <img src={publicPath("/assets/apps/jiajia-id-photo/web/icon.webp")} alt="" />
    </div>
  </section>

  <section class="featured-section page-shell" id="featured" aria-labelledby="featured-heading">
    <header class="section-heading section-heading--intro">
      <div><p class="section-label">{labels.galleryEyebrow}</p><h2 id="featured-heading">{labels.featuredApps}</h2></div>
      <p>{labels.galleryBody}</p>
    </header>
    <div class="featured-grid">
      {featuredApps.map((app, index) => <FeaturedApp app={app} locale={locale} tone={index === 0 ? "coral" : index === 1 ? "blue" : "green"} />)}
    </div>
  </section>

  {locale === "zh-Hans" && <section class="beta-guide page-shell" id="testflight" aria-labelledby="testflight-heading">
    <div class="beta-guide__copy">
      <p class="section-label">班主任小秘书 · TestFlight</p>
      <h2 id="testflight-heading">加入内测，提前试用班主任小秘书</h2>
      <p>面向中国用户的 iPhone / iPad 内测教程。需要先安装 Apple 的 TestFlight，再通过邀请链接加入测试。</p>
      <a class="button-link" href="https://testflight.apple.com/join/G4XDzZjC" target="_blank" rel="noreferrer">打开内测邀请链接 ↗</a>
    </div>
    <ol class="beta-guide__steps">
      <li><strong>下载 TestFlight</strong><span>在 App Store 搜索“TestFlight”，或点击上方链接后按提示安装。</span></li>
      <li><strong>打开邀请链接</strong><span>安装完成后，回到本页再次点击邀请链接，并选择“在 TestFlight 中打开”。</span></li>
      <li><strong>接受测试邀请</strong><span>在 TestFlight 中点击“接受”或“开始测试”，即可安装班主任小秘书内测版。</span></li>
      <li><strong>后续更新</strong><span>之后打开 TestFlight，在“App”列表里即可查看并安装新版本。</span></li>
    </ol>
  </section>}

  <section class="app-gallery page-shell" id="apps" aria-labelledby="apps-heading">
    <header class="section-heading">
      <p class="section-label">{labels.galleryEyebrow}</p>
      <h2 id="apps-heading">{labels.exploreApps}</h2>
    </header>
    <div class="app-gallery__grid">
      {visibleApps.map((app, index) => <AppCard app={app} locale={locale} position={index + 1} />)}
    </div>
  </section>

  <section class="updates-section page-shell" aria-labelledby="updates-heading">
    <header class="section-heading"><div><p class="section-label">FU apps</p><h2 id="updates-heading">{labels.latestUpdates}</h2></div></header>
    <div class="updates-list">{updateApps.map((app) => <UpdateRow app={app} locale={locale} />)}</div>
  </section>
</SiteLayout>
